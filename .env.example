# LongVid backend configuration. Copy to .env and adjust as needed.
# The local API is bound to 127.0.0.1 by design (see docs/architecture.md).

# Interface/port for the local API
LONGVID_HOST=127.0.0.1
LONGVID_PORT=8790

# Location of the SQLite database and project workspaces
LONGVID_DATA_DIR=../data
LONGVID_DATABASE_NAME=longvid.db

# Logging verbosity: critical | error | warning | info | debug | trace
LONGVID_LOG_LEVEL=info
